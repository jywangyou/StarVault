{
  "manifest_version": 3,
  "name": "繁星记",
  "version": "1.0",
  "description": "侧边栏日历插件，可自定义提醒事项，定时提醒",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
  },
  "content_scripts": [
  ],
  "permissions": [ "sidePanel", "contextMenus", "storage", "alarms", "notifications" ],
  "icons": {
    "128": "images/logo-128.png"
  }
}